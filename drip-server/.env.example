# ── Server ──────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── twitterapi.io ────────────────────────────────────────────────
# Get your key at https://twitterapi.io/dashboard
TWITTER_API_KEY=your_twitterapi_io_key_here

# ── Solana ───────────────────────────────────────────────────────
# RPC endpoint — use Helius/QuickNode/Alchemy for production
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Treasury wallet private key (base58) — keep this SECRET
# Used to sign DRIP token transfer transactions
TREASURY_PRIVATE_KEY=your_treasury_wallet_private_key_base58

# DRIP SPL token mint address on Solana
DRIP_MINT_ADDRESS=your_drip_token_mint_address_here

# ── Reward engine ────────────────────────────────────────────────
# How often to refresh tweet metrics (milliseconds). Default: 5 minutes
REWARD_POLL_INTERVAL_MS=300000
