# ── Server ───────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
SERVER_URL=http://localhost:4000

# ── Database ─────────────────────────────────────────────────────
# On Railway: add a Postgres service — DATABASE_URL is auto-injected
DATABASE_URL=postgresql://user:password@localhost:5432/drip

# ── X (Twitter) OAuth ────────────────────────────────────────────
# From developer.twitter.com → your app → Keys and tokens
# Also add callback URL: https://YOUR_SERVER_URL/api/auth/x/callback
X_CONSUMER_KEY=your_consumer_key
X_CONSUMER_SECRET=your_consumer_secret

# ── twitterapi.io ────────────────────────────────────────────────
# Used for reading tweet metrics (impressions, likes etc)
# Get from https://twitterapi.io/dashboard
TWITTER_API_KEY=your_twitterapi_io_key

# ── JWT ──────────────────────────────────────────────────────────
# Random secret string — generate with: openssl rand -base64 32
JWT_SECRET=your_random_jwt_secret_here

# ── Solana ───────────────────────────────────────────────────────
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
TREASURY_PRIVATE_KEY=your_treasury_wallet_private_key_base58
DRIP_MINT_ADDRESS=your_drip_token_mint_address

# ── Reward engine ────────────────────────────────────────────────
REWARD_POLL_INTERVAL_MS=300000
