# drip-server (existing)
NEXT_PUBLIC_API_URL=https://drip-server-production.up.railway.app

# betttr-radar — server-side proxy target (not exposed to browser)
# Local dev: run `npm run dev` in ../betttr-radar on port 3950
RADAR_API_URL=http://localhost:3950

# Production (Railway): leave RADAR_API_URL unset — `npm start` bundles betttr-radar automatically.
# Or set RADAR_API_URL to a separate radar service URL if you run one.
