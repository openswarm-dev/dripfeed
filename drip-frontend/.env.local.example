# drip-server (existing)
NEXT_PUBLIC_API_URL=https://drip-server-production.up.railway.app

# betttr-radar — server-side proxy target (not exposed to browser)
# Local: run `npm run dev` in ../betttr-radar on port 3950
RADAR_API_URL=http://localhost:3950

# Railway production: set RADAR_API_URL to your betttr-radar service URL, e.g.
# RADAR_API_URL=https://betttr-radar-production.up.railway.app
